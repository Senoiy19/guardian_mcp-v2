# --- Required for everything ---
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# An Alchemy URL is strongly recommended: other providers force the slow, capped fallback scan.

# --- Telegram bot ---
GUARDIAN_TELEGRAM_BOT_TOKEN=
GUARDIAN_DB_PATH=guardian.sqlite3
# GUARDIAN_WATCH_INTERVAL_SECONDS=900
# GUARDIAN_WATCH_WORKERS=4
# GUARDIAN_MAX_TOTAL_WATCHES=2000
# GUARDIAN_BUFFER_DROP_POINTS=5          # alert when buffer falls this many points below its 24h high
# GUARDIAN_RISK_REMINDER_HOURS=6
# GUARDIAN_SNAPSHOT_RETENTION_DAYS=30

# --- MCP server (remote Streamable HTTP only) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The server refuses to start with short or placeholder tokens.
MCP_API_TOKEN=
MCP_ALLOWED_HOSTS=your-service.up.railway.app,your-service.up.railway.app:*
MCP_ALLOWED_ORIGINS=
# Set to 1 only behind a trusted reverse proxy (Railway) so failed-login throttling sees real client IPs.
MCP_TRUST_PROXY=
PORT=8000
HOST=0.0.0.0
# GUARDIAN_MCP_CACHE_TTL_SECONDS=30
